{
  "plugins": {
    "chrome-devtools-plugin": {
      "enabled": true
    },
    "modern-web-guidance-plugin": {
      "enabled": true
    }
  },
  "userSettings": {
    "globalPermissionGrants": {
      "allow": [
        "unsandboxed(cat)",
        "unsandboxed(ls)",
        "unsandboxed(grep)",
        "unsandboxed(find . -name \"*wreath*\")",
        "unsandboxed(mkdir)",
        "unsandboxed(python3 --version)",
        "unsandboxed(git status)",
        "read_file(/tmp)",
        "read_file(/tmp/*)",
        "read_file(/tmp/**)",
        "write_file(/tmp)",
        "write_file(/tmp/*)",
        "write_file(/tmp/**)",
        "read_file(/private/tmp)",
        "read_file(/private/tmp/*)",
        "read_file(/private/tmp/**)",
        "write_file(/private/tmp)",
        "write_file(/private/tmp/*)",
        "write_file(/private/tmp/**)",
        "unsandboxed(head)",
        "unsandboxed(echo)",
        "unsandboxed(which)"
      ]
    }{{- if .user.geminiRemoteControlHostname }},
    "remoteControlHostname": "{{ .user.geminiRemoteControlHostname }}"{{- end }}
  }
}
