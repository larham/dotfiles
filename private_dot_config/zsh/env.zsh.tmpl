{{- if eq .chezmoi.os "darwin" -}}
export PATH=/opt/homebrew/bin:$PATH
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
{{ end -}}

export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"
[ -d "$HOME/workspace/flutter/bin" ] && export PATH="$PATH:$HOME/workspace/flutter/bin"
[ -d "$HOME/.gem/bin" ] && export GEM_HOME="$HOME/.gem" && export PATH="$GEM_HOME/bin:$PATH"
[ -d "/opt/homebrew/opt/mysql-client/bin" ] && export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

export GPG_TTY=$(tty)
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export GOPATH="$HOME"
export GO111MODULE=on
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_NO_AUTO_UPDATE=1
{{- end }}

# Bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"

# Eza
export EZA_CONFIG_DIR="$HOME/.config/eza"

# Starship
if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
  eval "$(starship init zsh)"
fi

# Load zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# fnm — Node version manager
if [ -d "$HOME/.local/share/fnm" ]; then
  export PATH="$HOME/.local/share/fnm:$PATH"
elif [ -d "$HOME/.fnm" ]; then
  export PATH="$HOME/.fnm:$PATH"
fi

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# direnv — per-directory environment variables
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || [ -d "$PYENV_ROOT/bin" ] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv >/dev/null 2>&1 && eval "$(pyenv init -)"

# rbenv
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - zsh)"

{{- if eq .chezmoi.os "darwin" }}
# Google Cloud SDK
export CLOUDSDK_PYTHON=python3
[ -f /usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc ] && source /usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc
[ -f /usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc ] && source /usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc
{{- end }}

# Helper functions
github-clone-cd() {
	local prefix=https://github.com/
	if [ "$1" = "--ssh" ]; then
		prefix=git@github.com:
		shift
	fi
	local dir="${HOME}/src/github.com/$1"
	if [ ! -d "${dir}" ]; then
		git clone "${prefix}$1.git" "${dir}"
	fi
	cd "${dir}"
}

github-clone-code() {
	local prefix=https://github.com/
	if [ "$1" = "--ssh" ]; then
		prefix=git@github.com:
		shift
	fi
	local dir="${HOME}/src/github.com/$1"
	if [ ! -d "${dir}" ]; then
		git clone "${prefix}$1.git" "${dir}"
	fi
	code "${dir}"
}
